# A workspace (your data) can sit inside the repository: none of it is ever committed.
elevendash.json
# Game logs hold account tokens, location and device ids. They never leave your computer.
logs/
*.log
# Built from the logs
build/
site/
reels/
reports/
videos.json
# elevendash demo
elevendash-demo/
demo-workspace/
# A hosted copy of the dashboard (integrations/claude_dashboard) keeps its state here
claude/

# Another site's data about a real match (opponent included), kept locally for calibration
11hero-match-*
parse-response.json

# Google client file and token live in %USERPROFILE%\.eleven-youtube, never here
client_secret*.json
token*.json
.env

